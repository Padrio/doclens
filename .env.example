# Required: Anthropic API key for image description (describe_images.py).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Vision model. Default is claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: System-prompt language for image descriptions ("en" or "de").
# DOCLENS_LANG=en

# Optional: Path to a custom system-prompt file (overrides DOCLENS_LANG).
# Useful to inject domain context: "this is a medical paper", "this is
# a German government protocol spec", etc.
# DOCLENS_SYSTEM_PROMPT_FILE=./system-prompt.txt

# Optional: OCR languages, "+"-separated (Docling/Tesseract). Default eng+deu.
# DOCLENS_OCR_LANG=eng+deu+fra
